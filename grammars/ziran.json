{
  "name": "Ziran",
  "scopeName": "source.ziran",
  "fileTypes": ["zi"],
  "patterns": [
    {"include": "#directives"},
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#declarations"},
    {"include": "#types"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#operators"}
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ziran",
          "begin": "\"",
          "end": "\"",
          "patterns": [{"name": "constant.character.escape.ziran", "match": "\\\\(?:[0-7]{1,3}|x[0-9a-fA-F]+|[\\\\\"'abfnrtv0])"}]
        },
        {
          "name": "string.quoted.single.ziran",
          "begin": "'",
          "end": "'",
          "patterns": [{"name": "constant.character.escape.ziran", "match": "\\\\(?:[0-7]{1,3}|x[0-9a-fA-F]+|[\\\\\"'abfnrtv0])"}]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.ziran",
          "match": "(?<!\\S)(#)(import|program_export|system_library|foreign|type|defined|ifx|if|assert)\\b",
          "captures": {
            "1": {"name": "punctuation.definition.directive.ziran"},
            "2": {"name": "keyword.control.directive.ziran"}
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.ziran", "match": "//.*$"},
        {"include": "#block_comment"},
        {"name": "comment.line.number-sign.ziran", "match": "#.*$"}
      ]
    },
    "block_comment": {
      "patterns": [
        {"name": "comment.block.ziran", "begin": "/\\*", "end": "\\*/", "patterns": [{"include": "#block_comment"}]}
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z_0-9]*)(\\s*)(::)(?=\\s*(?:\\(|struct\\b|enum\\b))",
          "captures": {
            "1": {"name": "entity.name.function.ziran"},
            "3": {"name": "keyword.operator.declaration.ziran"}
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z_0-9]*)(\\s*)(::)",
          "captures": {
            "1": {"name": "entity.name.constant.ziran"},
            "3": {"name": "keyword.operator.declaration.ziran"}
          }
        },
        {"name": "entity.name.function.call.ziran", "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "storage.type.ziran", "match": "\\b(?:bool|void|s8|s16|s32|s64|u8|u16|u32|u64|float32|float64|string)\\b"},
        {"name": "storage.type.definition.ziran", "match": "\\b(?:struct|enum)\\b"},
        {"name": "entity.name.type.ziran", "match": "\\b[A-Z][A-Za-z_0-9]*\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.ziran", "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?)(?:[uUlLfF]*)\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.ziran", "match": "\\b(?:if|else|for|while|break|continue|return|cast|size_of)\\b"},
        {"name": "constant.language.ziran", "match": "\\b(?:true|false|null)\\b"}
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.ziran", "match": "(?:::|:=|->|==|!=|<=|>=|&&|\\|\\||[+*/%=!<>?:&|^-])"}
      ]
    }
  }
}
